# =============================================================================
# Mina Local Daemon — reference systemd unit (low-spec profile)
# =============================================================================
# This is the RENDERED reference for the unit generated by install_service.sh
# (low-spec profile, system mode). Do not copy blindly — use the installer.
# Target hardware class: Bay Trail Celeron, 2-4 GB RAM, HDD class.
# =============================================================================

[Unit]
Description=Mina Local Daemon — Remote Device Control
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=youruser
WorkingDirectory=/home/youruser/.hermes/skills/system-control/mina-workspace/scripts
Restart=always
RestartSec=5
EnvironmentFile=/etc/mina/mina.env
ExecStart=/usr/bin/python3 /home/youruser/.hermes/skills/system-control/mina-workspace/scripts/mina_daemon.py --host 127.0.0.1 --port 8765

# ── Resource limits (low-spec profile — low-spec class hardware) ──
# The daemon idles around 25-35 MB RSS; 100M max leaves headroom for
# python + psutil + yaml without ever touching the old laptop's swap.
MemoryAccounting=yes
MemoryHigh=80M
MemoryMax=100M
MemorySwapMax=0
# CPU: low priority (nice 10) and a small relative cgroup share (20/100).
# Under contention the daemon yields to everything else on the laptop.
CPUWeight=20
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
# If a child process (browser, screenshot tool) is OOM-killed, keep the
# daemon itself alive — Tier-1 services stay up.
OOMPolicy=continue
# Hard CPU ceiling (optional, uncomment to throttle bursts further):
#CPUQuota=25%

# GUI actions from a system service need the desktop session's env:
#Environment=DISPLAY=:0
#Environment=XDG_RUNTIME_DIR=/run/user/1000
#Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mina-daemon

[Install]
WantedBy=multi-user.target
