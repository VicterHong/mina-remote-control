# Mina Workspace — Environment Variables
# Copy to .env and fill with real values. NEVER commit .env.

# HTTPS tunnel endpoint (Cloudflare Tunnel or ngrok)
MINA_TUNNEL_URL=https://your-tunnel.example.com

# API key for bearer auth (generate: python -c "import secrets; print('mina_sk_' + secrets.token_urlsafe(32))")
MINA_API_KEY=mina_sk_CHANGE_ME

# HMAC-SHA256 signing secret (generate: python -c "import secrets; print(secrets.token_hex(32))")
MINA_HMAC_SECRET=CHANGE_ME_64_char_hex

# Daemon listen port (only used locally; tunnel maps to this)
MINA_DAEMON_PORT=8765

# Log file path
MINA_LOG_FILE=~/.mina/logs/mina_daemon.log

# ── Performance profile (low-spec laptops: low-spec laptop) ──────────
# Leave commented to use config/mina.yaml performance: values.
# MINA_STATUS_CPU_INTERVAL=0.3   # status CPU sample window (seconds)
# MINA_DASHBOARD_REFRESH=60      # dashboard auto-refresh (seconds)
# MINA_CMD_TIMEOUT=20            # subprocess timeout (seconds)
# MINA_TIER2=off                 # disable Tier-2 GUI (pyautogui) entirely
# MINA_TIER2_MIN_FREE_MB=150     # auto-disable Tier-2 below this free RAM
# MINA_TIER2_MAX_FAILURES=2      # circuit breaker threshold

# ── Web UI / Auth (v1.3.0) ───────────────────────────────────────
# The web UI (login + credential generator) is ON by default. When these
# API vars are EMPTY, the daemon starts in setup mode: open /ui/ in the
# browser, create the account (one-time setup token in the daemon log),
# then click "Generate API & Secret Key". Credentials are stored in
# ~/.mina/credentials.env (chmod 600) and loaded automatically at boot.
# MINA_WEBUI=off                 # disable the web UI entirely
# MINA_AUTH_ITERATIONS=100000    # PBKDF2 cost (lower = faster login on weak CPU)
